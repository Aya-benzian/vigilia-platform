# ML Serving Local Environment Configuration Template
APP_NAME=ml-serving
APP_ENV=local
APP_VERSION=1.0.0
PORT=8000
LOG_LEVEL=INFO

# MLflow Tracking Coordinates
MLFLOW_TRACKING_URI=http://localhost:5000
ML_MODEL_NAME=fraud-model
ML_MODEL_ALIAS=champion
ML_DECISION_THRESHOLD=0.1948

# Fast-fail and backoff configuration
MLFLOW_HTTP_REQUEST_MAX_RETRIES=1
MLFLOW_HTTP_REQUEST_TIMEOUT=3
MODEL_LOAD_INITIAL_BACKOFF_SEC=1.0
MODEL_LOAD_MAX_BACKOFF_SEC=30.0

# Administrative Endpoint Authentication (Design 2 Section 15.5)
# Required for POST /admin/reload/{family}. In production/staging, supply via secret management.
ADMIN_API_KEY=

# Dummy model flag (allowed only when APP_ENV is 'local' or 'test')
USE_DUMMY_MODEL=false
