# ==============================================================================
# Vigilia Platform Environment Variables (.env.example)
# Copy this file to .env and fill in real values. NEVER commit .env to git.
# ==============================================================================

# LOCAL DEVELOPMENT ONLY — never use these credentials in production

# --- Database (PostgreSQL) ---
POSTGRES_DB=vigilia
POSTGRES_USER=vigilia
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_PORT=5432

# --- Spring Boot Services — Database ---
# Used by all backend services (auth, customer, transaction, risk-management)
DB_URL=jdbc:postgresql://localhost:5432/vigilia
DB_USERNAME=vigilia
DB_PASSWORD=change_me_in_production

# --- Spring Boot Services — JWT (auth-service) ---
# Generate with: openssl rand -base64 64
JWT_SECRET=change_me_with_a_long_random_base64_string

# --- Application Runtime & Observability ---
APP_NAME=vigilia
APP_ENV=development
APP_VERSION=0.0.1
LOG_LEVEL=INFO

# --- Ports ---
# Change any value if the default conflicts with something already on your host.
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000
ML_SERVING_PORT=8000
FRONTEND_PORT=8087
SERVER_PORT=8080
AUTH_SERVICE_PORT=8081
CUSTOMER_SERVICE_PORT=8082
TRANSACTION_SERVICE_PORT=8083
RISK_SERVICE_PORT=8084
NOTIFICATION_SERVICE_PORT=8085
AUDIT_SERVICE_PORT=8086

# --- Grafana ---
GF_SECURITY_ADMIN_PASSWORD=change_me_in_production

# --- MLflow Tracking & Model Registry ---
MLFLOW_PORT=5000
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=change_me_in_production
MLFLOW_DB_NAME=mlflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=vigilia-fraud-detection


# --- Email Delivery (Brevo REST API) ---
BREVO_ENABLED=false
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Vigilia Security
