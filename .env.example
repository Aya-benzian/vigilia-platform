# ==============================================================================
# Vigilia Platform Environment Variables (.env.example)
# ==============================================================================


# LOCAL DEVELOPMENT ONLY — never use these credentials in production

# --- Database (PostgreSQL) ---
POSTGRES_DB=vigilia
POSTGRES_USER=vigilia
POSTGRES_PASSWORD=vigilia_secret
POSTGRES_PORT=5432

# --- Application Runtime & Observability ---
APP_NAME=vigilia
APP_ENV=development
APP_VERSION=0.0.1
LOG_LEVEL=INFO

# --- Grafana ---
GF_SECURITY_ADMIN_PASSWORD=admin
