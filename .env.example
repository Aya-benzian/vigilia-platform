# ==============================================================================
# Vigilia Platform Environment Variables (.env.example)
# Copy this file to .env and fill in real values. NEVER commit .env to git.
# ==============================================================================

# LOCAL DEVELOPMENT ONLY — never use these credentials in production

# --- Database (PostgreSQL) ---
POSTGRES_DB=vigilia
POSTGRES_USER=vigilia
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_PORT=5432

# --- Spring Boot Services — Database ---
# Used by all backend services (auth, customer, transaction, risk-management)
DB_URL=jdbc:postgresql://localhost:5432/vigilia
DB_USERNAME=vigilia
DB_PASSWORD=change_me_in_production

# --- Spring Boot Services — Ports ---
# Override only if the default port is already in use on your machine
# api-gateway     : 8080
# auth-service    : 8081
# customer-service: 8082
# transaction-service: 8083
# risk-management-service: 8084
# SERVER_PORT=<override per service if needed>

# --- Spring Boot Services — JWT (auth-service) ---
# Generate with: openssl rand -base64 64
JWT_SECRET=change_me_with_a_long_random_base64_string

# --- Application Runtime & Observability ---
APP_NAME=vigilia
APP_ENV=development
APP_VERSION=0.0.1
LOG_LEVEL=INFO

# --- Grafana ---
GF_SECURITY_ADMIN_PASSWORD=change_me_in_production

# --- MLflow Tracking & Model Registry ---
MLFLOW_PORT=5000
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=change_me_in_production
MLFLOW_DB_NAME=mlflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=vigilia-fraud-detection

