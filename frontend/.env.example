# ─── Vigilia Frontend Environment Variables ───────────────────────────────────
# Copy to .env.local for local dev (never commit .env.local or .env to git)
# Variables prefixed VITE_ are exposed to the browser bundle.
# ──────────────────────────────────────────────────────────────────────────────

# API Gateway base URL (Spring Boot gateway — proxied by Vite dev server in dev)
# In dev this is used by Vite's proxy config in vite.config.js.
# In production K8s, Nginx proxies to the internal service.
VITE_API_BASE_URL=http://localhost:8080

# Prometheus (for monitor-dashboard direct queries during local dev)
# In K8s, these are routed through the API gateway or a Prometheus proxy.
VITE_PROMETHEUS_URL=http://localhost:9090

# Alertmanager
VITE_ALERTMANAGER_URL=http://localhost:9093

# App metadata
VITE_APP_NAME=Vigilia Platform
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

